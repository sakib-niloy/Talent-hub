# TalentHub web (Next.js). Copy to `.env.local` for local development.
# Everything here is read server-side by next.config.ts. Nothing is exposed to the browser bundle.

# Origin of the TalentHub API (Express). The app proxies /api/* to it, so the browser
# only ever talks to this Next.js origin and the auth cookie stays first-party.
#   local:      http://localhost:5000
#   production: https://<your-api>.onrender.com
API_ORIGIN=http://localhost:5000
