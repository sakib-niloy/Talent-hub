# TalentHub API configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

NODE_ENV=development
PORT=5000

# --- Database (MySQL) ---
# Use a dedicated least-privilege user, not root. DB_PASSWORD is required in production.
DB_HOST=localhost
DB_PORT=3306
DB_USER=talenthub_app
DB_PASSWORD=
DB_NAME=talent_hub

# --- Auth ---
# Both must be >= 32 random characters and different from each other.
JWT_SECRET=
JWT_EXPIRES_IN=1h
SESSION_SECRET=

# --- HTTP ---
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Number of reverse proxies in front of the app (0 locally, 1 on Render).
TRUST_PROXY=0

# --- Google OAuth (optional; leave blank to disable "Continue with Google") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/auth/google/callback
