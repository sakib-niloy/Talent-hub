# TalentHub API configuration. Copy to `.env` for local development (never commit `.env`).
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# --- Database ---
# Postgres connection string (Neon in production: use the *pooled* URL with ?sslmode=require).
# Leave empty locally to use the embedded PGlite database stored in PGLITE_DIR (no install needed).
DATABASE_URL=
PGLITE_DIR=./.data/pglite
RUN_MIGRATIONS=true

# --- Auth ---
JWT_SECRET=
SESSION_TTL_DAYS=7

# --- Web app / HTTP ---
# Public URL of the Next.js frontend (OAuth redirects land here; the API is reached via its /api proxy).
FRONTEND_URL=http://localhost:3000
# Browser origins allowed to call the API directly / send mutating requests.
CORS_ORIGINS=http://localhost:3000
# Reverse proxies in front of the API: 0 locally, 2 on Render behind the Vercel rewrite.
TRUST_PROXY=0

# --- Rate limits (optional) ---
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=600
RATE_LIMIT_UPLOAD=30

# --- Google OAuth (optional; leave blank to hide "Continue with Google") ---
# Authorized redirect URI in Google Cloud Console: ${FRONTEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Media storage ---
# local = files on disk (development only). s3 = any S3-compatible bucket (required in production).
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
# Cloudflare R2 example:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_URL=https://pub-<hash>.r2.dev   (or your custom domain)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true
